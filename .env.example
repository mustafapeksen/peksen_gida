# Pekşen Gıda istemci yapılandırması için boş şablon.
# Faz 1'de uygulama veya otomatik .env yükleme mekanizması yoktur.
# Gerçek proje değerleri yalnız ignore edilen yerel .env dosyasına yazılır.
SUPABASE_URL=

# Yalnız anon veya publishable istemci anahtarı.
# service_role / secret key, DB parolası, FCM sunucu veya imzalama sırrı eklenmez.
SUPABASE_ANON_KEY=
