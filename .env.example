# Yalnız public istemci değerleri. Gerçek secret/parola yazılmaz.
# Yerelde .env kopyası oluşturun; Git tarafından ignore edilir.
# flutter run --dart-define-from-file=.env -d CIHAZ_ID
# Yerel API: Android emulator http://10.0.2.2:55321; host http://127.0.0.1:55321
# Geçerli config mevcut hesaplarla girişi açar; oturum yalnız bellekte tutulur.
# Dosya asset olarak paketlenmez; verilen değerler derlemeye gömülür.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT için üstteki anahtarı boş bırakıp yalnız bunu doldurun.
# İki anahtar birlikte kabul edilmez. service_role/sb_secret_ yasaktır.
SUPABASE_ANON_KEY=
# Tüm değerler boşsa SDK başlatılmaz; debug önizlemesi ağsız çalışır.
