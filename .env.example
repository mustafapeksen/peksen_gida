# Yalnız public istemci değerleri. Gerçek secret/parola yazılmaz.
# Yerelde .env kopyası oluşturun; Git tarafından ignore edilir.
# flutter run --dart-define-from-file=.env -d CIHAZ_ID
# Yerel API: Android emulator http://10.0.2.2:55321; host http://127.0.0.1:55321
# Geçerli config giriş/kayıt akışını açar; oturum şifreli platform deposundadır.
# Dosya asset olarak paketlenmez; verilen değerler derlemeye gömülür.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT için üstteki anahtarı boş bırakıp yalnız bunu doldurun.
# İki anahtar birlikte kabul edilmez. service_role/sb_secret_ yasaktır.
SUPABASE_ANON_KEY=
# Tüm değerler boşsa SDK başlatılmaz; debug önizlemesi ağsız çalışır.

# Faz 12: MapLibre için public HTTPS stil adresi; üretim sağlayıcısı/lisansı açık.
# Boşsa yalnız debug MapLibre demo haritasını kullanır; release harita kapalıdır.
# Server secret veya URL kullanıcı/parolası koymayın.
MAP_STYLE_URL=

# Faz 14: yalnız Firebase Android public istemci kimlikleri, hepsi birlikte.
# Boşsa FCM kapalı; uygulama içi bildirim geçmişi kullanılabilir.
# Service-account JSON/private key veya OAuth token buraya konmaz.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
